# ==================================================
# Application
# ==================================================
NK_ENV_PROFILE=local

APP_ENV=development
APP_ENV_LOCAL=development
APP_ENV_LIVE=production
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost/api
APP_URL_LOCAL=http://localhost:3000/backend
APP_URL_LIVE=https://your-live-domain/backend
APP_PUBLIC_SITE_URL=http://localhost:3000
APP_PUBLIC_SITE_URL_LOCAL=http://localhost:3000
APP_PUBLIC_SITE_URL_LIVE=https://your-live-domain

# ==================================================
# Database (MySQL)
# ==================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_HOST_LOCAL=127.0.0.1
DB_PORT_LOCAL=3306
DB_NAME_LOCAL=your_local_database_name
DB_USER_LOCAL=your_local_database_user
DB_PASS_LOCAL=your_local_database_password
DB_HOST_LIVE=your-live-db-host
DB_PORT_LIVE=3306
DB_NAME_LIVE=your_live_database_name
DB_USER_LIVE=your_live_database_user
DB_PASS_LIVE=your_live_database_password

# ==================================================
# JWT
# ==================================================
# IMPORTANT: Generate a strong random secret (64+ chars)
# Example: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string_at_least_64_characters_long

# ==================================================
# Bootstrap Superadmin (used only on first deploy)
# ==================================================
BOOTSTRAP_SUPERADMIN_MOBILE=9999999999
BOOTSTRAP_SUPERADMIN_PASSWORD=change_this_password

# ==================================================
# Razorpay
# ==================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==================================================
# CRM (Aibunty)
# ==================================================
CRM_API_TOKEN=
CRM_API_ENDPOINT=https://admin.aibunty.com/api/automations/69db61c17e52a/execute
CRM_CA_BUNDLE_PATH=storage/certs/cacert.pem

# ==================================================
# Email (SMTP - Dcore Systems)
# ==================================================
SMTP_HOST=smtp.dcoresystems.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=noreply@dcoresystems.com
SMTP_PASS=
SMTP_FROM_NAME=Dcore Systems Support
EMAIL_CC=admin@yourdomain.com

# ==================================================
# CORS
# Comma-separated list of allowed origins, or * for all
# ==================================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost
CORS_ALLOWED_ORIGINS_LOCAL=http://localhost:3000,http://localhost
CORS_ALLOWED_ORIGINS_LIVE=https://your-live-domain,https://www.your-live-domain

# ==================================================
# FTP Deploy
# Used by the PowerShell deploy/test scripts when NK_ENV_PROFILE=live
# ==================================================
FTP_HOST_LIVE=ftp.your-host.com
FTP_USER_LIVE=your-ftp-user
FTP_PASS_LIVE=your-ftp-password
FTP_REMOTE_PATH_LIVE=your-remote-path/backend

# ==================================================
# Event Settings
# ==================================================
EVENT_VENUE_ADDRESS=Rockmount Commercial Hub, 4th Floor, Khadakpada Circle, Kalyan West, Thane, Maharashtra 421301
EVENT_BOOKING_PHONE=9999999999
EVENT_TICKET_CC_EMAIL=admin@yourdomain.com
EVENT_NO_REFUND_POLICY=No refund once pass is purchased.
